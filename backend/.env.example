NODE_ENV=development
PORT=3000

# Base de datos y autenticación
DATABASE_URL=postgresql://postgres:password@localhost:5432/pos_carmita
JWT_SECRET=replace_with_at_least_32_random_characters

# Orígenes separados por coma. En producción esta variable es obligatoria.
CORS_ORIGINS=http://localhost:4200,http://localhost:4201
TRUST_PROXY=

# Google Calendar permanece desactivado hasta una prueba controlada.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CREDENTIALS_PATH=

# Imágenes de servicios SIDRO (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SIDRO_FOLDER=sidro/services

# Recuperación de contraseña SIDRO (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Carmita Villegas Estilistas
BREVO_PASSWORD_RESET_TEMPLATE_ID=
BREVO_PASSWORD_CHANGED_TEMPLATE_ID=
SIDRO_PUBLIC_URL=http://localhost:4201
